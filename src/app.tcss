/* Nord-inspired modern theme for Cloudflare Edge Scanner TUI */

$surface: #2e3440;
$background: #242933;
$accent: #88c0d0;
$success: #a3be8c;
$warning: #ebcb8b;
$error: #bf616a;
$text: #eceff4;
$text-dim: #d8dee9;
$primary: #5e81ac;
$secondary: #b48ead;

Screen {
    background: $background;
    color: $text;
}

/* ========== HEADER & FOOTER ========== */

Header {
    background: $surface;
    color: $accent;
    height: 3;
    padding: 0 2;
    border-bottom: tall $primary;
}

Header > HeaderTitle {
    text-style: bold;
    color: $accent;
}

Footer {
    background: $surface;
    color: $text-dim;
    border-top: solid $primary;
    height: 1;
}

/* ========== TABBED CONTENT ========== */

TabbedContent {
    height: 1fr;
}

ContentSwitcher {
    height: 1fr;
}

TabPane {
    height: 1fr;
    padding: 1 2;
    overflow-y: auto;
}

TabbedContent > Tabs {
    background: $surface;
    height: 3;
}

TabbedContent > Tabs > Tab {
    padding: 0 3;
    color: $text-dim;
}

TabbedContent > Tabs > Tab.-active {
    color: $accent;
    text-style: bold;
    border-bottom: tall $accent;
}

TabbedContent > Tabs > Tab:hover {
    color: $text;
    background: $primary 40%;
}

/* ========== SPLIT PANES ========== */

.pane-left {
    width: 28;
    height: 100%;
    background: $surface;
    border-right: solid $background;
    padding: 0 1;
}

.pane-right {
    width: 1fr;
    height: 100%;
    padding: 0 1 0 2;
}

/* ========== TYPOGRAPHY ========== */

.section-title {
    text-style: bold;
    color: $accent;
    margin: 1 0;
    width: 100%;
    text-align: center;
    background: $background;
    padding: 0 1;
}

.pane-label {
    margin: 0 0 1 0;
}

/* ========== DATA TABLE ========== */

DataTable {
    height: 1fr;
    border: none;
    margin-bottom: 1;
}

DataTable > .datatable--header {
    background: $surface;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary 60%;
    color: $text;
}

DataTable > .datatable--hover {
    background: $primary 30%;
}

/* ========== LIST VIEW ========== */

ListView {
    background: transparent;
    border: none;
    height: 1fr;
}

ListItem {
    padding: 0 1;
    background: transparent;
}

ListItem.-highlight {
    background: $primary 50%;
    color: $text;
}

/* ========== BUTTONS ========== */

Button {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    border: none;
    background: $background;
    color: $text;
}

Button:hover {
    background: $primary 50%;
    color: $text;
}

Button:focus {
    background: $primary;
    color: $text;
}

Button.-primary {
    background: $primary;
    color: $text;
}

Button.-primary:hover {
    background: $accent;
    color: $background;
}

Button.-success {
    background: $success;
    color: $background;
}

Button.-success:hover {
    background: $success;
    color: $background;
    text-style: bold;
}

Button.-error {
    background: $error;
    color: $text;
}

Button.-error:hover {
    background: $error;
    color: $text;
    text-style: bold;
}

/* ========== INPUT ========== */

Input {
    border: none;
    background: $background;
    color: $text;
    margin-bottom: 1;
    height: 3;
    padding: 0 1;
}

Input:focus {
    border: tall $accent;
    background: $surface;
}

/* ========== PROGRESS BAR ========== */

ProgressBar {
    width: 100%;
    height: 1;
    margin: 1 0;
}

ProgressBar > Bar > .bar--bar {
    color: $accent;
    background: $accent 20%;
}

ProgressBar > Bar > .bar--complete {
    color: $success;
}

ProgressBar > PercentageStatus {
    color: $text-dim;
    text-style: bold;
}

/* ========== RADIO SET ========== */

RadioSet {
    background: transparent;
    border: none;
    margin-bottom: 1;
}

RadioButton {
    padding: 0 1;
    height: 2;
    color: $text-dim;
}

RadioButton.-selected {
    color: $accent;
    text-style: bold;
}

RadioButton:hover {
    color: $text;
    background: $primary 30%;
}

/* ========== RICH LOG ========== */

RichLog {
    background: transparent;
    border: none;
    height: auto;
}

/* ========== SCREEN WIDGETS ========== */

DashboardScreen, ScannerScreen, CleanIPScreen, XrayScreen, DeployScreen {
    height: 1fr;
}

/* ========== DASHBOARD ========== */

#dash-container {
    height: 100%;
    padding: 1 2;
}

#dash-header {
    content-align: center middle;
    height: 5;
    text-style: bold;
    color: $accent;
    margin-bottom: 2;
}

#stats-row {
    height: 6;
    margin-bottom: 2;
}

.stat-card {
    width: 1fr;
    height: 100%;
    background: $surface;
    border: solid $primary;
    padding: 1 1;
    margin: 0 1;
}

.stat-card:hover {
    border: double $accent;
}

.stat-title {
    color: $text-dim;
    text-style: bold;
    text-align: center;
}

.stat-value {
    color: $accent;
    text-style: bold;
    text-align: center;
    height: 3;
}

#quick-actions {
    height: 5;
    margin-bottom: 2;
}

#quick-actions Button {
    width: 1fr;
    margin: 0 1;
}

#activity-section {
    height: 1fr;
}

#activity-log {
    height: 1fr;
    border: solid $primary;
    padding: 1;
}

/* ========== SCANNER ========== */

#results-table {
    height: 1fr;
}

#scan-log {
    height: 6;
    border: solid $primary;
    padding: 0 1;
}

/* ========== CLEAN IP ========== */

#clean-results-table {
    height: 1fr;
}

#clean-log {
    height: 5;
    border: solid $primary;
    padding: 0 1;
}

/* ========== XRAY ========== */

.stage-status {
    height: 2;
    padding: 0 1;
    margin-bottom: 1;
}

#xray-results-table {
    height: 1fr;
}

#xray-log {
    height: 5;
    border: solid $primary;
    padding: 0 1;
}

/* ========== DEPLOY ========== */

#deploy-console {
    height: 1fr;
    border: solid $primary;
    padding: 1;
}

.warning-text {
    color: $warning;
    text-align: center;
    margin-top: 1;
}

/* ========== MODAL DIALOGS ========== */

ModalScreen {
    align: center middle;
}

ModalScreen > Vertical {
    width: 50;
    height: auto;
    background: $surface;
    border: tall $accent;
    padding: 1 2;
}

.dialog-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.dialog-hint {
    color: $text-dim;
    margin-bottom: 1;
}

.dialog-buttons {
    height: auto;
}

.dialog-buttons Button {
    width: 1fr;
    margin: 1 1 0 1;
}

/* ========== BUTTON ROW ========== */

.btn-row {
    height: auto;
    margin-bottom: 1;
}

.btn-row Button {
    width: 1fr;
    margin: 0 1 0 0;
}

.btn-row Button:last-child {
    margin-right: 0;
}

/* ========== HIDDEN ========== */

.hidden {
    display: none;
}
